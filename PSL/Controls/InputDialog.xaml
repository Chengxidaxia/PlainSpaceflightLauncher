<Window x:Class="PSL.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource AppFont}"
        FontSize="{StaticResource FontSizeNormal}">

    <Border Margin="14" Background="{StaticResource BrushPanelBg}" CornerRadius="10"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#333E48" />
        </Border.Effect>

        <StackPanel Margin="22,20,22,18">
            <TextBlock x:Name="TxtTitle" Text="输入" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="TxtMessage" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextSecondary}" LineHeight="19" />

            <TextBox x:Name="TxtValue" Margin="0,14,0,0" Height="34"
                     Padding="8,0" VerticalContentAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Style="{StaticResource BtnBase}" MinWidth="82" Click="Cancel_Click" />
                <Button Content="确定" Style="{StaticResource BtnPrimary}" MinWidth="82" Margin="10,0,0,0"
                        Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
