<Window x:Class="PSL.Controls.TaskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请稍候"
        Width="440" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="{StaticResource AppFont}" FontSize="{StaticResource FontSizeNormal}">

    <Border Margin="14" Background="{StaticResource BrushPanelBg}" CornerRadius="10"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.18" Color="#333E48" />
        </Border.Effect>

        <StackPanel Margin="22,20,22,18">
            <TextBlock x:Name="TxtTitle" Text="正在处理" FontSize="16" FontWeight="SemiBold" />
            <TextBlock x:Name="TxtMessage" Margin="0,8,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource BrushTextSecondary}" LineHeight="19" />

            <ProgressBar x:Name="Bar" Margin="0,18,0,0" Height="6" Minimum="0" Maximum="100" Value="0" />
            <Grid Margin="0,8,0,0">
                <TextBlock x:Name="TxtStatus" Text="准备中…" Foreground="{StaticResource BrushTextTertiary}"
                           FontSize="{StaticResource FontSizeSmall}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="TxtPercent" Text="" HorizontalAlignment="Right"
                           Foreground="{StaticResource BrushTextSecondary}"
                           FontSize="{StaticResource FontSizeSmall}" />
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource BtnBase}" MinWidth="82"
                        Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
