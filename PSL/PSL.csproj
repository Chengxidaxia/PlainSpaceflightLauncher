<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PSL</RootNamespace>
    <AssemblyName>PlainSpaceflightLauncher</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 注意：本项目按需求刻意不设置 ApplicationIcon，最终 exe 使用系统默认图标 -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>


    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>PlainSpaceflightLauncher</Product>
    <AssemblyTitle>PlainSpaceflightLauncher</AssemblyTitle>
    <Description>Spaceflight Simulator 的第三方启动器</Description>
    <Company>Chengxidaxia</Company>
    <Copyright>Copyright (C) 2026 Chengxidaxia. Licensed under GPL-3.0-only.</Copyright>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- WindowsDesktop SDK 的隐式 using 不含 System.IO，这里补上 -->
  <ItemGroup>
    <Resource Include="Assets\Chinese.ico" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2957.106" />
    <PackageReference Include="SharpCompress" Version="0.38.0" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!-- 单 exe：把托管依赖嵌进 exe（Costura.Fody） -->
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
  </ItemGroup>



</Project>
