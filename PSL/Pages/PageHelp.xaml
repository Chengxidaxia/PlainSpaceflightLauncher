<ctl:PclPage x:Class="PSL.Pages.PageHelp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PSL.Controls"
             Background="Transparent">

    <ctl:PclPageRight x:Name="PanRight" AnimatedControl="PanMain">
        <ScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMain" Margin="25,25,25,10">

                <ctl:PclCard Margin="0,0,0,15" Title="帮助文档">
                    <StackPanel Margin="25,40,25,20">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconHelp}" Stretch="Uniform" Width="20" Height="20"
                                  Fill="{StaticResource ColorBrush3}" VerticalAlignment="Center" />
                            <TextBlock Text="帮助文档正在编写中" FontSize="17" FontWeight="Bold" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource ColorBrush3}" />
                            <Border Margin="10,0,0,0" Background="{StaticResource BrushPrimaryPale}"
                                    CornerRadius="4" Padding="7,1" VerticalAlignment="Center">
                                <TextBlock Text="WIP" Foreground="{StaticResource BrushWarning}"
                                           FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="21"
                                   Foreground="{StaticResource ColorBrushGray1}"
                                   Text="帮助页还在开发中，后续会在这里补充完整的使用说明与常见问题。当前可先参考下面的功能速查。" />
                    </StackPanel>
                </ctl:PclCard>

                <ctl:PclCard Margin="0,0,0,15" Title="功能速查">
                    <StackPanel Margin="25,40,25,20">
                        <TextBlock TextWrapping="Wrap" LineHeight="22"
                                   Foreground="{StaticResource ColorBrushGray1}"
                                   Text="· 主页：左下角是「启动游戏」按钮，它下面一行是「版本选择」与「版本设置」。&#x0a;· 版本选择：左边是游戏文件夹列表，右边列出该文件夹下的版本；点一个版本即可选中它。&#x0a;· 版本设置：管理当前版本的模组 / 涂装包 / 零件包 / 星系包 / 蓝图。&#x0a;· 下载：从 SFS 汉化模组站获取模组 / 涂装包 / 零件包 / 蓝图。&#x0a;· 设置：游戏库目录、下载线程数、关于信息与运行日志。&#x0a;· 把 .dll / .pack / .zip 拖进窗口即可自动识别并安装到当前版本；zip 会自动判断里面是模组、涂装包、零件包、星系包还是蓝图。" />

                        <ctl:PclHint Margin="0,16,0,0" Theme="Blue">
                            <TextBlock TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{StaticResource ColorBrushGray1}"
                                       Text="本启动器只支持 Spaceflight Simulator 1.6 及以上版本；DLL 模组仅 PC / Steam 版可用。" />
                        </ctl:PclHint>

                        <Button Style="{StaticResource BtnPrimary}" Content="打开 SFS 汉化模组站教程"
                                MinWidth="220" Padding="13,0" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Click="OpenSite_Click" />
                    </StackPanel>
                </ctl:PclCard>

            </StackPanel>
        </ScrollViewer>
    </ctl:PclPageRight>
</ctl:PclPage>
