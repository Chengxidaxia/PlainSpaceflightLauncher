<ctl:PclPage x:Class="PSL.Pages.PageDownload"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PSL.Controls"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左栏 =================
             照 PCL `Pages/PageDownload/PageDownloadLeft.xaml`：
               MyPageLeft{ AnimatedControl="PanItem" } > MyScrollViewer{ Style=ScrollViewerFullMargin }
               > StackPanel Margin="0,12,0,0"
             每项 MyListItem{ Checked, IsScaleAnimationEnabled=False, Type=RadioBox,
                              MinPaddingRight=35, Height=36, VerticalAlignment=Top, Title, Logo }
             + 一个「刷新」MyIconButton{ LogoScale=0.85 }；第一项之后插入分组标题
             `TextBlock{ Text="社区资源", Margin=(13,20,5,4), Opacity=0.6, FontSize=12 }`（:16）。
             PCL 的第一项是「原版游戏」（:8）——本项目保留这个位置给「游戏本体」下载（WIP），
             社区资源按 SFS 站点实际字段分为 DLL 模组 / 涂装包 / 零件包 / 蓝图。
             源码根元素**没有**写宽度，由列表项自然撑开。 -->
        <ctl:PclPageLeft x:Name="PanLeft" Grid.Column="0" AnimatedControl="PanItem">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanItem" Margin="0,12,0,0">
                    <ctl:PclListItem x:Name="ItemChinese" Type="RadioBox" Height="36" MinPaddingRight="35"
                                     VerticalAlignment="Top" Title="汉化版" Checked="True"
                                     Logo="{StaticResource IconDownload}" Click="Tab_Click" />
                    <ctl:PclListItem x:Name="ItemOriginal" Type="RadioBox" Height="36" MinPaddingRight="35"
                                     VerticalAlignment="Top" Title="原版（暂不可用）"
                                     Logo="{StaticResource IconGameBox}" Click="Tab_Click" />
                    <TextBlock Text="社区资源" Margin="13,20,5,4" Opacity="0.6" FontSize="12" />
                    <ctl:PclListItem x:Name="ItemMod" Type="RadioBox" Height="36" MinPaddingRight="35"
                                     VerticalAlignment="Top" Title="DLL 模组"
                                     Logo="{StaticResource IconMod}" Click="Tab_Click" />
                    <ctl:PclListItem x:Name="ItemTexture" Type="RadioBox" Height="36" MinPaddingRight="35"
                                     VerticalAlignment="Top" Title="涂装包"
                                     Logo="{StaticResource IconTexturePack}" Click="Tab_Click" />
                    <ctl:PclListItem x:Name="ItemParts" Type="RadioBox" Height="36" MinPaddingRight="35"
                                     VerticalAlignment="Top" Title="零件包"
                                     Logo="{StaticResource IconPartsPack}" Click="Tab_Click" />
                    <ctl:PclListItem x:Name="ItemBlueprint" Type="RadioBox" Height="36" MinPaddingRight="35"
                                     VerticalAlignment="Top" Title="蓝图"
                                     Logo="{StaticResource IconBlueprint}" Click="Tab_Click" />
                </StackPanel>
            </ScrollViewer>
        </ctl:PclPageLeft>

        <!-- ================= 右栏 =================
             照 PCL `Pages/PageDownload/Resource/PageResource.xaml`：
               MyScrollViewer > StackPanel Margin="25"
                 ├ MyCard Title="搜索XXX" Margin="0,0,0,15" + StackPanel Margin="25,40,25,15"
                 │   ├ 条件网格（名称 / 版本 / 来源 / 类型，行高 28 间距 9）
                 │   └ 按钮行（Height=35，SharedSizeGroup="Button"：搜索 / 重置条件）
                 ├ StackPanel PanContent
                 │   ├ MyCard CardProjects UseAnimation=False + StackPanel PanProjects Margin="12"
                 │   ├ MyCard CardPages 分页（首页 / 上一页 / 页码 / 下一页）
                 └ MyCard PanLoad 加载态 -->
        <ctl:PclPageRight x:Name="PanRight" Grid.Column="1" AnimatedControl="PanMain">
            <ScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanMain" Margin="25" Grid.IsSharedSizeScope="True">

                    <!-- ============ 汉化版（对应 PCL 顶部「最新预览版 / 最新正式版」卡的位置） ============ -->
                    <StackPanel x:Name="PanChinese" Visibility="Collapsed">
                        <ctl:PclCard x:Name="CardLatest" Margin="0,0,0,15" Title="最新汉化版">
                            <Grid Margin="25,38,25,18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="46" Height="46" CornerRadius="6"
                                        Background="{StaticResource BrushPrimaryPale}">
                                    <Image x:Name="ImgLatest" Width="38" Height="38" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtLatestName" FontSize="17" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="TxtLatestInfo" Margin="0,3,0,0" FontSize="11"
                                               Foreground="{StaticResource ColorBrushGray3}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource BtnPrimary}" Content="下载"
                                        MinWidth="110" Padding="13,0" Height="35" VerticalAlignment="Center"
                                        Click="BtnLatestDownload_Click" />
                            </Grid>
                        </ctl:PclCard>

                        <ctl:PclCard x:Name="CardChineseList" Margin="0,0,0,15" Title="全部汉化版">
                            <StackPanel x:Name="PanChineseList" Margin="12,38,12,12" />
                        </ctl:PclCard>

                        <ctl:PclCard x:Name="CardChineseEmpty" Margin="0,0,0,15" Visibility="Collapsed">
                            <StackPanel Margin="20,17">
                                <TextBlock x:Name="TxtChineseEmptyTitle" Text="正在读取版本列表" FontSize="19"
                                           HorizontalAlignment="Center" Margin="0,0,0,9"
                                           Foreground="{StaticResource ColorBrush3}" />
                                <Rectangle Height="2" HorizontalAlignment="Stretch"
                                           Fill="{StaticResource ColorBrush3}" />
                                <TextBlock x:Name="TxtChineseEmpty" Text="正在连接汉化版仓库…" Margin="10,15,10,0"
                                           TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"
                                           Foreground="{StaticResource ColorBrushGray1}" />
                                <Button Style="{StaticResource BtnPrimary}" Content="刷新"
                                        Height="35" MinWidth="140" Padding="13,0"
                                        HorizontalAlignment="Center" Margin="0,15,0,0"
                                        Click="BtnRefreshChinese_Click" />
                            </StackPanel>
                        </ctl:PclCard>

                        <ctl:PclHint Theme="Blue" Margin="0,0,0,15">
                            <TextBlock TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{StaticResource ColorBrushGray1}"
                                       Text="汉化版来自 Chengxidaxia/SFS1.6Chinese 的 Release；版本名取 Release 名称，安装包带密码时会自动使用内置安装密码。" />
                        </ctl:PclHint>
                    </StackPanel>

                    <!-- 搜索条件卡 -->
                    <ctl:PclCard x:Name="CardSearch" Margin="0,0,0,15" Title="搜索资源">
                        <StackPanel Margin="25,40,25,15">
                            <Grid HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1.3*" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="9" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Text="名称" Margin="0,0,18,0" />
                                <ctl:PclSearchBox x:Name="SearchName" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                                  HintText="搜索名称 / 作者 / 标签" TextChanged="SearchName_TextChanged" />

                                <TextBlock Grid.Row="0" Grid.Column="4" VerticalAlignment="Center"
                                           HorizontalAlignment="Left" Text="数据源" Margin="0,0,18,0" />
                                <ComboBox x:Name="ComboSite" Grid.Row="0" Grid.Column="5"
                                          SelectionChanged="ComboSite_SelectionChanged" />

                                <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Text="链接" Margin="0,0,18,0" />
                                <ComboBox x:Name="ComboLink" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                          SelectionChanged="ComboLink_SelectionChanged">
                                    <ComboBoxItem Content="全部" IsSelected="True" />
                                    <ComboBoxItem Content="有直链（可多线程下载）" />
                                    <ComboBoxItem Content="仅蓝奏云" />
                                </ComboBox>

                                <TextBlock Grid.Row="2" Grid.Column="4" VerticalAlignment="Center"
                                           HorizontalAlignment="Left" Text="类型" Margin="0,0,18,0" />
                                <ComboBox x:Name="ComboKind" Grid.Row="2" Grid.Column="5"
                                          SelectionChanged="ComboKind_SelectionChanged">
                                    <ComboBoxItem Content="全部" IsSelected="True" />
                                    <ComboBoxItem Content="DLL 模组" />
                                    <ComboBoxItem Content="涂装包" />
                                    <ComboBoxItem Content="零件包" />
                                    <ComboBoxItem Content="蓝图" />
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,4,0,6" Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnPrimary}" Content="搜索"
                                        MinWidth="140" Padding="13,0" Margin="0,0,20,0"
                                        Click="BtnSearch_Click" />
                                <Button Style="{StaticResource BtnBase}" Content="重置条件"
                                        MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="1"
                                        Click="BtnReset_Click" />
                                <Button Style="{StaticResource BtnBase}" Content="刷新数据"
                                        MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="2"
                                        Click="BtnRefresh_Click" />
                            </Grid>
                        </StackPanel>
                    </ctl:PclCard>

                    <!-- ============ 游戏本体下载（WIP 占位，对应 PCL 的「原版游戏」项） ============ -->
                    <ctl:PclCard x:Name="CardGame" Margin="0,0,0,15" Title="原版下载" Visibility="Collapsed">
                        <StackPanel Margin="25,40,25,20">
                            <TextBlock TextWrapping="Wrap" LineHeight="20"
                                       Foreground="{StaticResource ColorBrushGray1}"
                                       Text="原版游戏下载功能正在开发中（WIP），暂时只能下载汉化版。" />
                            <ctl:PclHint Margin="0,14,0,0" Theme="Blue">
                                <TextBlock TextWrapping="Wrap" LineHeight="19"
                                           Foreground="{StaticResource ColorBrushGray1}"
                                           Text="你现在可以手动从 Steam 下载游戏，然后用主页左下角的「版本选择」→「添加版本文件夹」把它加入游戏目录。&#x0a;判定标准：文件夹根目录下存在 Spaceflight Simulator.exe。" />
                            </ctl:PclHint>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Style="{StaticResource BtnPrimary}" Content="打开 Steam 商店页"
                                        MinWidth="150" Padding="13,0" Click="BtnOpenSteam_Click" />
                                <Button Style="{StaticResource BtnBase}" Content="去「版本选择」添加"
                                        MinWidth="150" Padding="13,0" Margin="10,0,0,0"
                                        Click="BtnGoSelect_Click" />
                            </StackPanel>
                        </StackPanel>
                    </ctl:PclCard>

                    <!-- 内容区 -->
                    <StackPanel x:Name="PanContent">
                        <ctl:PclHint x:Name="HintError" Theme="Blue" Margin="0,0,0,15">
                            <TextBlock x:Name="TxtSource" TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{StaticResource ColorBrushGray1}"
                                       Text="资源来自 SFS 汉化模组站（sfszhmod.pages.dev）。" />
                        </ctl:PclHint>

                        <ctl:PclCard x:Name="CardProjects" Margin="0,0,0,15">
                            <StackPanel x:Name="PanProjects" Margin="12" />
                        </ctl:PclCard>

                        <!-- 分页（PageResource.xaml:78-89） -->
                        <ctl:PclCard x:Name="CardPages" HorizontalAlignment="Center" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal" Height="23" Margin="10,7">
                                <ctl:PclIconButton x:Name="BtnPageFirst" IsEnabled="False" Opacity="0.2"
                                                   Margin="0,0.5,5,0.5" ToolTip="首页"
                                                   Logo="{StaticResource IconTop}" Click="BtnPageFirst_Click" />
                                <ctl:PclIconButton x:Name="BtnPageLeft" IsEnabled="False" Opacity="0.2"
                                                   Margin="0,0,5,0" ToolTip="上一页"
                                                   Logo="{StaticResource IconBack}" Click="BtnPageLeft_Click" />
                                <TextBlock x:Name="LabPage" Text="1 / 1" Margin="8,0,13,0" FontSize="15"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource ColorBrush3}" />
                                <ctl:PclIconButton x:Name="BtnPageRight" Margin="0,0,30,0" ToolTip="下一页"
                                                   Logo="{StaticResource IconRefresh}" Click="BtnPageRight_Click" />
                            </StackPanel>
                        </ctl:PclCard>
                    </StackPanel>

                    <!-- 空态 / 加载态（PageResource.xaml:91-93） -->
                    <ctl:PclCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="40,50">
                        <StackPanel Margin="20,17">
                            <TextBlock x:Name="TxtTitleEmpty" Text="正在加载" FontSize="19"
                                       HorizontalAlignment="Center" Margin="0,0,0,9"
                                       Foreground="{StaticResource ColorBrush3}" />
                            <Rectangle Height="2" HorizontalAlignment="Stretch"
                                       Fill="{StaticResource ColorBrush3}" />
                            <TextBlock x:Name="TxtEmpty" Text="正在加载数据…" Margin="10,15,10,0"
                                       TextWrapping="Wrap" MaxWidth="400" TextAlignment="Center"
                                       Foreground="{StaticResource ColorBrushGray1}" />
                            <Button Style="{StaticResource BtnPrimary}" Content="打开模组站"
                                    Height="35" MinWidth="140" Padding="13,0"
                                    HorizontalAlignment="Center" Margin="0,15,0,0"
                                    Click="BtnOpenSite_Click" />
                        </StackPanel>
                    </ctl:PclCard>
                </StackPanel>
            </ScrollViewer>
        </ctl:PclPageRight>
    </Grid>
</ctl:PclPage>
