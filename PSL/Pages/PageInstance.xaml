<ctl:PclPage x:Class="PSL.Pages.PageInstance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PSL.Controls"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左栏 =================
             照 PCL `Pages/PageInstance/PageInstanceLeft.xaml`：
               MyPageLeft{ AnimatedControl="PanItem" } > StackPanel Margin="0,12,0,0"
               每项 MyListItem{ IsScaleAnimationEnabled=False, Type=RadioBox, MinPaddingRight=35,
                                Height=36, VerticalAlignment=Top, Title=分类名 }
             PCL 的分类是「概览 / 设置 / Mod 管理 / Mod 管理（禁用） / 导出」，
             PSL 换成「概览 / 设置 + 五类 SFS 资源」。
             开启「汉化版功能」后额外追加「字体 / 语言包」两项（见 PageInstance.xaml.cs）。
             PCL 这里**没有**给左栏固定宽度（宽度由列表项自然撑开），主页那 300 是
             `PageLaunchLeft.xaml:8` 单独写死的。 -->
        <ctl:PclPageLeft x:Name="PanLeft" Grid.Column="0" AnimatedControl="PanItem">
            <StackPanel x:Name="PanItem" Margin="0,12,0,0">
                <ctl:PclListItem x:Name="ItemOverall" Type="RadioBox" Height="36" MinPaddingRight="35"
                                 VerticalAlignment="Top" Title="概览"
                                 Logo="{StaticResource IconAll}" Checked="True" Click="Section_Click" />
                <ctl:PclListItem x:Name="ItemSetup" Type="RadioBox" Height="36" MinPaddingRight="35"
                                 VerticalAlignment="Top" Title="设置"
                                 Logo="{StaticResource IconSetup}" Click="Section_Click" />
                <ctl:PclListItem x:Name="ItemMod" Type="RadioBox" Height="36" MinPaddingRight="35"
                                 VerticalAlignment="Top" Title="模组"
                                 Logo="{StaticResource IconMod}" Click="Section_Click" />
                <ctl:PclListItem x:Name="ItemTexture" Type="RadioBox" Height="36" MinPaddingRight="35"
                                 VerticalAlignment="Top" Title="涂装包"
                                 Logo="{StaticResource IconTexturePack}" Click="Section_Click" />
                <ctl:PclListItem x:Name="ItemParts" Type="RadioBox" Height="36" MinPaddingRight="35"
                                 VerticalAlignment="Top" Title="零件包"
                                 Logo="{StaticResource IconPartsPack}" Click="Section_Click" />
                <ctl:PclListItem x:Name="ItemSystem" Type="RadioBox" Height="36" MinPaddingRight="35"
                                 VerticalAlignment="Top" Title="星系包"
                                 Logo="{StaticResource IconSystemPack}" Click="Section_Click" />
                <ctl:PclListItem x:Name="ItemBlueprint" Type="RadioBox" Height="36" MinPaddingRight="35"
                                 VerticalAlignment="Top" Title="蓝图"
                                 Logo="{StaticResource IconBlueprint}" Click="Section_Click" />
                <ctl:PclListItem x:Name="ItemFont" Type="RadioBox" Height="36" MinPaddingRight="35"
                                 VerticalAlignment="Top" Title="字体"
                                 Logo="{StaticResource IconTexturePack}" Visibility="Collapsed"
                                 Click="Section_Click" />
                <ctl:PclListItem x:Name="ItemLanguage" Type="RadioBox" Height="36" MinPaddingRight="35"
                                 VerticalAlignment="Top" Title="语言包"
                                 Logo="{StaticResource IconAbout}" Visibility="Collapsed"
                                 Click="Section_Click" />
            </StackPanel>
        </ctl:PclPageLeft>

        <!-- ================= 右栏 =================
             照 PCL `Pages/PageInstance/PageInstanceOverall.xaml`：
               MyPageRight{ PanScroll="PanBack" } > MyScrollViewer > StackPanel x:Name="PanMain"
             所有分类共用同一个滚动区，靠显示/隐藏卡片切换（PCL 是把各分类做成独立页面，
             这里为减少类数量合并为一个页，但每张卡片的 Margin / 标题 / 内容边距完全照源码）。 -->
        <ctl:PclPageRight x:Name="PanRight" Grid.Column="1" AnimatedControl="PanMain">
            <ScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanMain" Margin="25,10">

                    <!-- ============ 概览（PageInstanceOverall.xaml:10-12） ============ -->
                    <ctl:PclCard x:Name="CardHeader" Margin="0,15" Title="">
                        <Grid Margin="10,7" Name="PanDisplayItem">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="6" Margin="0,0,12,0"
                                    Background="{StaticResource BrushPrimaryPale}">
                                <Path Data="{StaticResource IconGameBox}" Stretch="Uniform"
                                      Width="22" Height="22" Fill="{StaticResource BrushPrimary}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtVersionName" Text="未选择版本"
                                           FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="TxtVersionPath" Margin="0,3,0,0"
                                           Foreground="{StaticResource ColorBrushGray3}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </ctl:PclCard>

                    <!-- ============ 概览：快捷方式（PageInstanceOverall.xaml:64-71） ============ -->
                    <ctl:PclCard x:Name="CardFolder" Margin="0,0,0,15" Title="快捷方式">
                        <WrapPanel Margin="25,30,25,20">
                            <Button Style="{StaticResource BtnBase}" Content="版本文件夹"
                                    MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35"
                                    Click="BtnOpenVersion_Click" />
                            <Button Style="{StaticResource BtnBase}" Content="模组文件夹"
                                    MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35"
                                    Click="BtnOpenMods_Click" />
                            <Button Style="{StaticResource BtnBase}" Content="涂装包文件夹"
                                    MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35"
                                    Click="BtnOpenTexture_Click" />
                            <Button Style="{StaticResource BtnBase}" Content="蓝图文件夹"
                                    MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35"
                                    Click="BtnOpenBlueprint_Click" />
                            <Button Style="{StaticResource BtnBase}" Content="存档文件夹"
                                    MinWidth="140" Padding="13,0" Margin="0,13,20,0" Height="35"
                                    Click="BtnOpenSaving_Click" />
                        </WrapPanel>
                    </ctl:PclCard>

                    <!-- ============ 概览：高级管理（PageInstanceOverall.xaml:72-85） ============ -->
                    <ctl:PclCard x:Name="CardManage" Margin="0,0,0,15" Title="高级管理">
                        <StackPanel Margin="25,40,25,15">
                            <Grid Margin="0,2,0,7" Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnBase}" Content="重新扫描"
                                        MinWidth="140" Padding="13,0" Margin="0,0,20,0"
                                        Click="BtnRefresh_Click" />
                                <Button Style="{StaticResource BtnBase}" Content="打开翻译器文件夹"
                                        MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="1"
                                        Click="BtnOpenTranslator_Click" />
                                <Button Style="{StaticResource BtnDanger}" Content="移除版本"
                                        MinWidth="140" Padding="13,0" Margin="0,0,20,0" Grid.Column="2"
                                        Click="BtnRemoveVersion_Click" />
                            </Grid>
                        </StackPanel>
                    </ctl:PclCard>

                    <!-- ============ 设置（PageInstanceSetup.xaml 的卡片结构） ============ -->
                    <ctl:PclCard x:Name="CardSetup" Margin="0,15,0,15" Title="设置">
                        <StackPanel Margin="25,40,25,21">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="9" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="9" />
                                    <RowDefinition Height="28" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Text="汉化版功能" Margin="0,0,25,0" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource SegTab}" Content="开启"
                                                 x:Name="RadioLocalOn" GroupName="Localization"
                                                 Checked="RadioLocal_Checked" />
                                    <RadioButton Style="{StaticResource SegTab}" Content="关闭"
                                                 x:Name="RadioLocalOff" GroupName="Localization"
                                                 Margin="6,0,0,0" Checked="RadioLocal_Checked" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Text="启动方式" Margin="0,0,25,0" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource SegTab}" Content="直接启动游戏"
                                                 x:Name="RadioLaunchDirect" GroupName="LaunchMode"
                                                 Checked="RadioLaunch_Checked" />
                                    <RadioButton Style="{StaticResource SegTab}" Content="通过 Steam 启动"
                                                 x:Name="RadioLaunchSteam" GroupName="LaunchMode"
                                                 Margin="6,0,0,0" Checked="RadioLaunch_Checked" />
                                </StackPanel>

                                <TextBlock Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Text="管理员权限" Margin="0,0,25,0" />
                                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <RadioButton Style="{StaticResource SegTab}" Content="普通启动"
                                                 x:Name="RadioAdminOff" GroupName="AdminMode"
                                                 Checked="RadioAdmin_Checked" />
                                    <RadioButton Style="{StaticResource SegTab}" Content="以管理员身份启动"
                                                 x:Name="RadioAdminOn" GroupName="AdminMode"
                                                 Margin="6,0,0,0" Checked="RadioAdmin_Checked" />
                                </StackPanel>
                            </Grid>

                            <ctl:PclHint x:Name="HintLocalization" Margin="0,15,0,0" Theme="Blue">
                                <TextBlock TextWrapping="Wrap" LineHeight="19"
                                           Foreground="{StaticResource ColorBrushGray1}"
                                           Text="开启后，左栏会多出「字体」「语言包」两个分类，可以为当前版本应用字体与语言包（写入该版本 AutoTranslator\Config.ini）。" />
                            </ctl:PclHint>
                        </StackPanel>
                    </ctl:PclCard>

                    <!-- ============ 资源列表（各分类共用） ============ -->
                    <ctl:PclCard x:Name="CardResource" Margin="0,15,0,15" Title="模组">
                        <StackPanel Margin="20,38,18,18">
                            <ctl:PclSearchBox x:Name="SearchBox" Margin="0,0,0,12"
                                              HintText="搜索名称 / 描述" TextChanged="SearchBox_TextChanged" />

                            <Grid Margin="0,0,0,13" Height="35">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource BtnPrimary}" Content="打开文件夹"
                                        MinWidth="120" Padding="13,0" Margin="0,0,15,0"
                                        Click="BtnOpenResourceDir_Click" />
                                <Button Style="{StaticResource BtnBase}" Content="安装本地文件"
                                        MinWidth="120" Padding="13,0" Margin="0,0,15,0" Grid.Column="1"
                                        Click="BtnInstallLocal_Click" />
                                <Button Style="{StaticResource BtnBase}" Content="刷新列表"
                                        MinWidth="120" Padding="13,0" Margin="0,0,15,0" Grid.Column="2"
                                        Click="BtnRefreshList_Click" />
                            </Grid>

                            <StackPanel x:Name="PanList" />
                        </StackPanel>
                    </ctl:PclCard>

                    <!-- ============ 字体 ============ -->
                    <ctl:PclCard x:Name="CardFont" Margin="0,15,0,15" Title="字体">
                        <StackPanel Margin="20,38,18,18">
                            <ctl:PclHint x:Name="HintFont" Theme="Blue">
                                <TextBlock TextWrapping="Wrap" LineHeight="19"
                                           Foreground="{StaticResource ColorBrushGray1}"
                                           Text="字体位于 版本目录\Spaceflight Simulator_Data\Custom Fonts\。选中一个字体后点「应用字体」，会写入该版本 AutoTranslator\Config.ini 的 OverrideFont 与 OverrideFontTextMeshPro。" />
                            </ctl:PclHint>
                            <StackPanel x:Name="PanFontList" Margin="0,13,0,0" />
                        </StackPanel>
                    </ctl:PclCard>

                    <!-- ============ 语言包 ============ -->
                    <ctl:PclCard x:Name="CardLanguage" Margin="0,15,0,15" Title="语言包">
                        <StackPanel Margin="20,38,18,18">
                            <ctl:PclHint x:Name="HintLanguage" Theme="Blue">
                                <TextBlock TextWrapping="Wrap" LineHeight="19"
                                           Foreground="{StaticResource ColorBrushGray1}"
                                           Text="语言包位于 版本目录\Spaceflight Simulator_Data\Custom Translations\。选中一个语言包后点「应用语言包」，会写入该版本 AutoTranslator\Config.ini 的 OutputFile。" />
                            </ctl:PclHint>
                            <StackPanel x:Name="PanLanguageList" Margin="0,13,0,0" />
                        </StackPanel>
                    </ctl:PclCard>

                    <!-- ============ 空态（PageInstanceMod.xaml:38-54） ============ -->
                    <ctl:PclCard x:Name="PanEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="40,20,40,40">
                        <StackPanel Margin="20,17">
                            <TextBlock x:Name="TxtTitleEmpty" Text="这里还没有内容" FontSize="19"
                                       HorizontalAlignment="Center" Margin="0,0,0,9"
                                       Foreground="{StaticResource ColorBrush3}" />
                            <Rectangle Height="2" HorizontalAlignment="Stretch"
                                       Fill="{StaticResource ColorBrush3}" />
                            <TextBlock x:Name="TxtEmpty" Margin="10,15,10,0" TextWrapping="Wrap"
                                       MaxWidth="420" TextAlignment="Center"
                                       Foreground="{StaticResource ColorBrushGray1}" />
                            <Button Style="{StaticResource BtnPrimary}" Content="打开文件夹"
                                    Height="35" MinWidth="140" Padding="13,0"
                                    HorizontalAlignment="Center" Margin="0,15,0,0"
                                    Click="BtnEmptyOpenDir_Click" />
                        </StackPanel>
                    </ctl:PclCard>

                </StackPanel>
            </ScrollViewer>
        </ctl:PclPageRight>
    </Grid>
</ctl:PclPage>
