<ctl:PclPage x:Class="PSL.Pages.PageHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:PSL.Controls"
             Background="Transparent">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= 左栏（对应 PCL 的 PageLaunchLeft） =================
             宽度取自源码 `PageLaunch/PageLaunchLeft.xaml:8` 的 `Width="300"`（真实属性，非 d: 设计值）。
             行结构完全沿用 PCL：Auto / * / Auto / Auto / 20
             PSL 隐藏了账号登录，Row1（PCL 的 PanLogin 选账号位置）改放「版本图标 + 版本名」。 -->
        <ctl:PclPageLeft x:Name="PanLeft" Grid.Column="0" Width="300" AnimatedControl="PanItem">
            <Grid x:Name="PanItem">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <!-- Row1：PCL 的 PanLogin（Grid.ColumnSpan=5 Grid.Row=1 Margin="20,0"）原本放账号登录，
                     PSL 把「版本图标 + 版本名」放这里，居中、可点击进入版本选择。
                     图标底板照 PageInstanceOverall.xaml 的 40×40 圆角 6。 -->
                <Grid Grid.Row="1" Grid.ColumnSpan="5" Margin="20,0" VerticalAlignment="Center"
                      x:Name="PanVersion" MouseLeftButtonUp="PanVersion_Click" Cursor="Hand">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="40" Height="40" CornerRadius="6"
                                Background="{StaticResource BrushPrimaryPale}">
                            <Path Data="{StaticResource IconGameBox}" Stretch="Uniform"
                                  Width="22" Height="22" Fill="{StaticResource BrushPrimary}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLeftVersionName" Text="未选择版本" FontSize="15"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtLeftVersionNumber" Margin="0,2,0,0" FontSize="11"
                                       Foreground="{StaticResource ColorBrushGray3}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 列定义逐字照 PCL `PageLaunch/PageLaunchLeft.xaml:17-23`：Auto / 20 / 1* / Auto / 10。
                     第 2 列固定 20 就是左边距，第 5 列固定 10 就是右边距；两个按钮直接落在第 3、4 列。 -->

                <!-- 启动按钮（PCL `PageLaunchLeft.xaml:58-70` 的 Row2 区块）
                     Grid 跨全部 5 列，**按钮自身 Margin="20,0"** —— 左右各留 20，
                     故按钮宽度 = 左栏宽 − 40（不是撑满整栏）。
                     样式 BtnLaunch：高 54、ColorType=Highlight（= 白底 + ColorBrush2 描边/文字）、Padding 30,0,30,15。
                     下方小字即 PCL 的 LabVersion（FontSize 11 / ColorBrushGray3 / Margin 35,0,35,10）。 -->
                <Grid Grid.Row="2" Grid.ColumnSpan="5">
                    <Button x:Name="BtnLaunch" Style="{StaticResource BtnLaunch}" Content="启动游戏"
                            Margin="20,0" Click="BtnLaunch_Click" />
                    <TextBlock x:Name="TxtLaunchHint" Margin="35,0,35,10" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource ColorBrushGray3}" />
                </Grid>

                <!-- 版本选择 / 版本设置：PCL `PageLaunchLeft.xaml:27-28` 就是直接放在 PanInput 上的
                     （BtnVersion 占 1* 列被拉宽，BtnMore 在 Auto 列自适应），这里照抄，不另包一层 Grid。
                     BtnMore 默认 Collapsed，只有选中版本时才显示（PageLaunchLeft.xaml.vb:689-691）。 -->
                <Button x:Name="BtnVersion" Grid.Row="3" Grid.Column="2"
                        Style="{StaticResource BtnBase}"
                        Content="版本选择" Height="35" Margin="0,10,10,0"
                        Click="BtnVersion_Click" />
                <Button x:Name="BtnMore" Grid.Row="3" Grid.Column="3"
                        Style="{StaticResource BtnBase}"
                        Content="版本设置" Height="35" Margin="0,10,10,0" Visibility="Collapsed"
                        Click="BtnMore_Click" />
            </Grid>
        </ctl:PclPageLeft>

        <!-- ================= 右栏（对应 PCL 的 PageLaunchRight） ================= -->
        <ctl:PclPageRight x:Name="PanRight" Grid.Column="1" AnimatedControl="PanMain">
            <ScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PanMain" Margin="25,25,25,10">

                    <!-- 公告（内容来自汉化版仓库根目录 new.html，见 PageHome.xaml.cs 的 LoadAnnouncement） -->
                    <ctl:PclCard x:Name="CardAnnounce" Margin="0,0,0,15" Title="公告">
                        <StackPanel Margin="25,38,25,16">
                            <ctl:PclHint x:Name="HintUpdate" Theme="Yellow" Margin="0,0,0,12"
                                         Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="TxtUpdate" TextWrapping="Wrap" LineHeight="19"
                                               Foreground="{StaticResource ColorBrushGray1}" />
                                    <Button Style="{StaticResource BtnPrimary}" Content="去下载最新汉化版"
                                            Height="32" MinWidth="160" HorizontalAlignment="Left"
                                            Margin="0,10,0,0" Click="BtnUpdate_Click" />
                                </StackPanel>
                            </ctl:PclHint>

                            <StackPanel x:Name="PanAnnounce" />
                            <TextBlock x:Name="TxtAnnounceEmpty" Text="正在读取公告…"
                                       TextWrapping="Wrap" LineHeight="19"
                                       Foreground="{StaticResource ColorBrushGray3}" />
                        </StackPanel>
                    </ctl:PclCard>

                    <!-- 当前版本（对应 PCL PageInstanceOverall 首张标题为空的版本信息卡） -->
                    <ctl:PclCard Margin="0,0,0,15" Title="当前版本">
                        <Grid Margin="25,40,25,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border x:Name="VersionAvatar" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                                    Height="72" CornerRadius="10"
                                    Background="{StaticResource BrushPrimaryPale}">
                                <Path Data="{StaticResource IconLaunch}" Stretch="Uniform"
                                      Width="32" Height="32"
                                      Fill="{StaticResource BrushPrimaryLight}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Row="0" Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtVersionName" Text="未选择版本"
                                           FontSize="17" FontWeight="Bold" TextWrapping="Wrap" />
                                <Border x:Name="BadgeVersion" Margin="0,6,0,0" HorizontalAlignment="Left"
                                        Background="{StaticResource BrushPrimaryPale}" CornerRadius="9"
                                        Padding="9,2" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtVersionNumber"
                                               Foreground="{StaticResource BrushPrimary}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="TxtVersionPath" Grid.Row="1" Grid.Column="2"
                                       Margin="0,10,0,0" TextWrapping="Wrap"
                                       Foreground="{StaticResource ColorBrushGray3}"
                                       FontSize="10.5" LineHeight="15" />
                        </Grid>
                    </ctl:PclCard>

                    <ctl:PclCard Margin="0,0,0,15" Title="快速操作">
                        <WrapPanel Margin="25,40,25,20">
                            <Button Style="{StaticResource BtnBase}" Content="添加已有文件夹" Height="35"
                                    MinWidth="140" Padding="13,0" Margin="0,0,20,8"
                                    Click="BtnAddFolder_Click" />
                            <Button Style="{StaticResource BtnBase}" Content="打开游戏目录" Height="35"
                                    MinWidth="140" Padding="13,0" Margin="0,0,20,8"
                                    Click="BtnOpenLibrary_Click" />
                            <Button Style="{StaticResource BtnBase}" Content="重新扫描" Height="35"
                                    MinWidth="140" Padding="13,0" Margin="0,0,20,8"
                                    Click="BtnRefresh_Click" />
                        </WrapPanel>
                    </ctl:PclCard>

                    <ctl:PclCard Margin="0,0,0,15" Title="当前版本资源概览">
                        <UniformGrid Columns="5" Margin="25,40,25,20">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="StatMod" Text="0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource ColorBrush3}" />
                                <TextBlock Text="DLL 模组" Foreground="{StaticResource ColorBrushGray2}"
                                           FontSize="{StaticResource FontSizeSmall}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="StatTexture" Text="0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource ColorBrush3}" />
                                <TextBlock Text="涂装包" Foreground="{StaticResource ColorBrushGray2}"
                                           FontSize="{StaticResource FontSizeSmall}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="StatParts" Text="0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource ColorBrush3}" />
                                <TextBlock Text="零件包" Foreground="{StaticResource ColorBrushGray2}"
                                           FontSize="{StaticResource FontSizeSmall}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="StatSystem" Text="0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource ColorBrush3}" />
                                <TextBlock Text="星系包" Foreground="{StaticResource ColorBrushGray2}"
                                           FontSize="{StaticResource FontSizeSmall}" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="StatBlueprint" Text="0" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource ColorBrush3}" />
                                <TextBlock Text="蓝图" Foreground="{StaticResource ColorBrushGray2}"
                                           FontSize="{StaticResource FontSizeSmall}" Margin="0,2,0,0" />
                            </StackPanel>
                        </UniformGrid>
                    </ctl:PclCard>

                    <ctl:PclCard x:Name="NoticeBox" Margin="0,0,0,15" Title="使用提示">
                        <TextBlock Margin="25,40,25,20" TextWrapping="Wrap" LineHeight="20"
                                   Foreground="{StaticResource ColorBrushGray1}"
                                   Text="· 把 .dll / .pack / .zip 拖进窗口即可自动识别并安装到当前版本（zip 会自动判断是模组 / 涂装包 / 零件包 / 星系包 / 蓝图）。&#x0a;· 左边「版本选择」里，左栏是游戏文件夹列表、右栏列出该文件夹下的版本；「版本设置」用来管理模组 / 涂装包 / 零件包 / 星系包 / 蓝图。&#x0a;· 模组下载在「下载」页，直链支持多线程加速；没有直链时会用浏览器打开蓝奏云。&#x0a;· 本启动器只支持 Spaceflight Simulator 1.6 及以上版本。" />
                    </ctl:PclCard>

                </StackPanel>
            </ScrollViewer>
        </ctl:PclPageRight>
    </Grid>
</ctl:PclPage>
